{
  "schema": 1,
  "abi": "rinos-sdk-v1",
  "targets": ["i686-unknown-rinos", "x86_64-unknown-rinos"],
  "include_directory": "include",
  "libraries": {
    "rincrt": {"archive": "librincrt.ra", "shared": "rincrt.rll", "define": "RINSDK_BUILD_CORE", "dependencies": [], "extra_sources": ["rincrt_bootstrap_v1.c"]},
    "rinbase": {"archive": "librinbase.ra", "shared": "rinbase.rll", "define": "RINSDK_BUILD_BASE", "dependencies": ["rincrt"]},
    "rinipc": {"archive": "librinipc.ra", "shared": "rinipc.rll", "define": "RINSDK_BUILD_IPC", "dependencies": ["rincrt", "rinbase"]},
    "rinfs": {"archive": "librinfs.ra", "shared": "rinfs.rll", "define": "RINSDK_BUILD_FS", "dependencies": ["rincrt", "rinbase", "rinipc"]},
    "rinnet": {"archive": "librinnet.ra", "shared": "rinnet.rll", "define": "RINSDK_BUILD_NET", "dependencies": ["rincrt", "rinbase", "rinipc"]},
    "ringui": {"archive": "libringui.ra", "shared": "ringui.rll", "define": "RINSDK_BUILD_GUI", "dependencies": ["rincrt", "rinbase", "rinipc"]},
    "rinmedia": {"archive": "librinmedia.ra", "shared": "rinmedia.rll", "define": "RINSDK_BUILD_MEDIA", "dependencies": ["rincrt", "rinbase"]},
    "rinconfig": {"archive": "librinconfig.ra", "shared": "rinconfig.rll", "define": "RINSDK_BUILD_CONFIG", "dependencies": ["rincrt", "rinbase"]},
    "rinpkg": {"archive": "librinpkg.ra", "shared": "rinpkg.rll", "define": "RINSDK_BUILD_PKG", "dependencies": ["rincrt", "rinbase", "rinipc"]},
    "rindevice": {"archive": "librindevice.ra", "shared": "rindevice.rll", "define": "RINSDK_BUILD_DEVICE", "dependencies": ["rincrt", "rinbase"]}
  }
}
